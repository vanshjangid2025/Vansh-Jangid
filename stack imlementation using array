#include <stdio.h>
#define MAX 5
int stack[MAX], top = -1;
void push() {
    int val;
    if (top == MAX - 1) printf("Overflow!\n");
    else {
        printf("Enter value: ");
        scanf("%d", &val);
        stack[++top] = val;
    }
}
void pop() {
    if (top == -1) printf("Underflow!\n");
    else printf("Popped: %d\n", stack[top--]);
}
void display() {
    if (top == -1) printf("Stack is empty!\n");
    else {
        printf("Stack elements: ");
        for (int i = top; i >= 0; i--) printf("%d ", stack[i]);
        printf("\n");
    }
}
int main() {
    int ch;
    do {
        printf("\n1.Push 2.Pop 3.Display 4.Exit\nChoice: ");
        scanf("%d", &ch);
        if (ch == 1) push();
        else if (ch == 2) pop();
        else if (ch == 3) display();
    } while (ch != 4);
    return 0;
}
